# Copy this file to .env (same folder as this file) and fill in every value.
# Every value is emitted as an ARM deployment output when the lab starts — see
# README.md "How to run" step 2 for the az CLI commands that read them.

# Azure OpenAI endpoint on the Foundry account.
# Example: https://smuftft-a1b2c3d4e5f6g.openai.azure.com
AZURE_OPENAI_ENDPOINT=https://<your-foundry-account>.openai.azure.com

# Base gpt-4.1-mini deployment name — target for inference AND source model for the SFT job.
BASE_MODEL_DEPLOYMENT=gpt-4-1-mini-base

# Foundry project endpoint (used by AIProjectClient in optional exercises).
# Example: https://<foundry>.services.ai.azure.com/api/projects/summitline-finetune
AZURE_AI_PROJECT_ENDPOINT=https://<your-foundry-account>.services.ai.azure.com/api/projects/summitline-finetune

# Foundry project name (child of the account).
AZURE_AI_PROJECT_NAME=summitline-finetune

# Storage account name — provisioned by the ARM template. Not used for JSONL upload
# (Exercise 3 uploads the JSONL directly to the fine-tuning files API), but exposed
# for optional large-dataset labs and downstream extension work.
AZURE_STORAGE_ACCOUNT_NAME=<your-storage-account>

# Prefix appended to every SFT job's suffix. Keep short (<=32 chars) — the
# fine-tuned model name is capped at 40 characters after this + a timestamp.
FINETUNE_JOB_NAME_PREFIX=summitline-concierge
