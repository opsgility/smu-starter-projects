# Copy this file to .env at the starter project root (next to src/).
# Every value is emitted as an ARM deployment output when the lab starts -
# see Exercise 1 Step 4 for the az CLI block that populates it.

# Foundry project endpoint (Agents Service + inference target)
AZURE_AI_PROJECT_ENDPOINT=https://<foundry-account>.services.ai.azure.com/api/projects/summitline-video
AZURE_AI_PROJECT_NAME=summitline-video

# Content Understanding endpoint (Foundry account root, CU lives under /contentunderstanding/*)
AZURE_CU_ENDPOINT=https://<foundry-account>.cognitiveservices.azure.com

# Model deployments on the Foundry account
MODEL_DEPLOYMENT=gpt-5.1
EMBEDDING_DEPLOYMENT=text-embedding-3-large

# Storage account holding the videos/ container
AZURE_STORAGE_ACCOUNT_NAME=<storage-account-name>

# AI Search service + the index the exercises create
AZURE_SEARCH_ENDPOINT=https://<search-service>.search.windows.net
AZURE_SEARCH_INDEX_NAME=video-segments
