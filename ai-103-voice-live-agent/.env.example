# Filled in during Lesson 6 exercise 1 (Sign in and verify environment). Rehydrated
# by the ARM template (course 557 lab 2587) via the Environment tab outputs.
# All auth is keyless via DefaultAzureCredential + Foundry User + Speech role on the
# azureaiuser credential — never store API keys here.

AZURE_AI_PROJECT_ENDPOINT=https://<your-foundry>.services.ai.azure.com/api/projects/summitline-voice-live
AZURE_AI_SPEECH_ENDPOINT=https://<your-foundry>.services.ai.azure.com
AZURE_AI_CHAT_DEPLOYMENT=gpt-5-mini
AZURE_AI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
AZURE_AI_SEARCH_ENDPOINT=https://<your-search>.search.windows.net
AZURE_AI_SEARCH_INDEX=summitline-products
AZURE_STORAGE_BLOB_ENDPOINT=https://<your-storage>.blob.core.windows.net
AZURE_STORAGE_CONTAINER=product-docs

# Voice Live session config
VOICE_LIVE_VOICE=en-US-AriaNeural
VOICE_LIVE_SAMPLE_RATE=24000
