# Values injected by the lab environment on start.

# The deployed flow endpoint (Foundry -> project -> Prompt flow -> deployed flow -> Endpoint URL).
AURORA_FLOW_ENDPOINT=https://<flow-endpoint>.inference.ml.azure.com/flow/consulting-copilot/score

# Azure AI project connection string — used by the AI Projects SDK.
# Foundry -> project -> Settings -> Overview -> Connection string.
AZURE_AI_PROJECT_CONNECTION_STRING=<project-connection-string>
