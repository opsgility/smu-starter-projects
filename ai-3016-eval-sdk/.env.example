# Values injected by the lab environment on start.

# The deployed flow endpoint - see ai-3016-copilot-client for the pattern.
AURORA_FLOW_ENDPOINT=https://<flow-endpoint>.inference.ml.azure.com/flow/consulting-copilot/score

# The Azure OpenAI endpoint + deployment for the JUDGE model.
# IMPORTANT: use a different deployment than the one that GENERATES answers
# to avoid self-preference bias (Lesson 14 topic 2).
JUDGE_OPENAI_ENDPOINT=https://<hub>.openai.azure.com/openai/deployments/aurora-gpt-4o-mini
JUDGE_DEPLOYMENT=aurora-gpt-4o-mini
JUDGE_API_VERSION=2024-08-01-preview
