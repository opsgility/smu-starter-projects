# Copy to .env and fill in the values from your AI Foundry deployment.
# Foundry -> your project -> Deployments -> aurora-gpt-4o-prod -> Endpoint URL.

AZURE_INFERENCE_ENDPOINT=https://<your-hub-name>.openai.azure.com/openai/deployments/aurora-gpt-4o-prod
AZURE_INFERENCE_DEPLOYMENT=aurora-gpt-4o-prod
AZURE_INFERENCE_API_VERSION=2024-08-01-preview

# When running with Managed Identity or Azure CLI, no key is required — the
# DefaultAzureCredential will find your credentials automatically.
# Only set this if you're using API-key auth for a quick local test:
# AZURE_INFERENCE_KEY=<your-key>
