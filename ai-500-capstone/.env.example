# Filled in from the lab's Environment tab. Values are pre-provisioned by the lab's ARM template.
FOUNDRY_PROJECT_ENDPOINT=https://<your-foundry>.services.ai.azure.com/api/projects/<your-project>
FOUNDRY_MODEL=gpt-5
CONTAINER_APP_NAME=<your-container-app>
CONTAINER_APP_ENV=<your-container-app-env>
ACR_LOGIN_SERVER=<your-acr>.azurecr.io
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=<key>;IngestionEndpoint=https://<region>.in.applicationinsights.azure.com/
