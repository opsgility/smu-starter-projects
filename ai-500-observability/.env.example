# Filled in during Lesson 13 from the lab's Environment tab.
# The ARM template attached to this lab emits FOUNDRY_PROJECT_ENDPOINT, FOUNDRY_MODEL,
# APPLICATIONINSIGHTS_CONNECTION_STRING, and LOG_ANALYTICS_WORKSPACE_ID as outputs.
FOUNDRY_PROJECT_ENDPOINT=https://<your-foundry>.services.ai.azure.com/api/projects/<your-project>
FOUNDRY_MODEL=gpt-5
APPLICATIONINSIGHTS_CONNECTION_STRING=<InstrumentationKey=...;IngestionEndpoint=...;LiveEndpoint=...;ApplicationId=...>
LOG_ANALYTICS_WORKSPACE_ID=<subscriptions/.../resourceGroups/.../providers/Microsoft.OperationalInsights/workspaces/...>
