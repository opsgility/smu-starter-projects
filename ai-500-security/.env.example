# Copy to .env and fill in the values from your lab's Environment tab.
# All four values are outputs of the lab's ARM template (see Foundry deployment + Key Vault).

FOUNDRY_PROJECT_ENDPOINT=https://<your-foundry-account>.services.ai.azure.com/api/projects/portfolio-review
FOUNDRY_MODEL=gpt-5
KEY_VAULT_NAME=<your-key-vault-name>
KEY_VAULT_URI=https://<your-key-vault-name>.vault.azure.net/

# Exercise 2 fills these in after the student creates their own Key Vault inside ai500-l15-security-rg.
STUDENT_KEY_VAULT_NAME=<fill-in-exercise-2>
STUDENT_KEY_VAULT_URI=<fill-in-exercise-2>
