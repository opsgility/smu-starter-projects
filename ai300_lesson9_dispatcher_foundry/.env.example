# Azure AI Foundry — copy from the "AI Foundry" tab in the lab environment panel
AZURE_FOUNDRY_ENDPOINT=https://<foundry-account>.services.ai.azure.com
AZURE_FOUNDRY_PROJECT=dispatcher

# Model deployment names under the "dispatcher" project
CHAT_DEPLOYMENT=gpt-5.1
EMBEDDING_DEPLOYMENT=text-embedding-3-large

# Azure Container Apps target (pre-provisioned, empty)
ACA_ENV_NAME=<container-apps-env-name>
ACA_APP_NAME=dispatcher-api
ACA_RESOURCE_GROUP=<lab-resource-group>

# Azure Container Registry (pre-provisioned)
ACR_NAME=<acr-name>

# Application Insights (already wired to the Log Analytics workspace)
APPLICATIONINSIGHTS_CONNECTION_STRING=<pull from the App Insights blade>

# OpenTelemetry service identity
OTEL_SERVICE_NAME=dispatcher-api
