# Copy to .env after completing Lesson 2 Exercise 3.
# Values come from the Foundry portal's project overview + deployment card.
# Env-var names match Microsoft Learning's mslearn-ai-studio repo verbatim so
# candidates studying from both sources never have to translate names.

# From your Foundry project overview (Azure AI Foundry portal > your project > Overview).
# Format: https://<your-foundry>.services.ai.azure.com/api/projects/<your-project>
AZURE_OPENAI_ENDPOINT=https://<your-foundry>.services.ai.azure.com/api/projects/<your-project>

# The deployment NAME you gave your gpt-5.2 model in Exercise 3 (typically gpt-5.2).
MODEL_DEPLOYMENT=gpt-5.2
