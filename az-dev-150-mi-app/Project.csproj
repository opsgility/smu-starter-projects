<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Anchorline.MiApp</RootNamespace>
    <EnableSdkContainerSupport>true</EnableSdkContainerSupport>
    <ContainerRepository>anchorline-mi-app</ContainerRepository>
    <ContainerBaseImage>mcr.microsoft.com/dotnet/nightly/aspnet:10.0-noble-chiseled</ContainerBaseImage>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.13.2" />
    <PackageReference Include="Azure.Security.KeyVault.Secrets" Version="4.7.0" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.24.0" />
    <PackageReference Include="Microsoft.Azure.Cosmos" Version="3.46.1" />
  </ItemGroup>
</Project>
