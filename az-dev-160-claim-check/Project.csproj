<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Anchorline.ClaimCheck</RootNamespace>
    <AssemblyName>claim-check</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <!--
      SDK pins refreshed 2026-09-18 against Microsoft Learn current-latest package pages:
        Azure.Identity              — https://learn.microsoft.com/dotnet/api/overview/azure/identity-readme (1.17.2)
        Azure.Messaging.ServiceBus  — https://learn.microsoft.com/dotnet/api/overview/azure/messaging.servicebus-readme (7.20.2)
        Azure.Storage.Blobs         — https://learn.microsoft.com/dotnet/api/overview/azure/storage.blobs-readme (12.29.2)
      Claim-check pattern is the current MS-recommended shape for large payloads
      (https://learn.microsoft.com/azure/service-bus-messaging/service-bus-messaging-overview).
      Floating <major>.* per current Microsoft guidance.
    -->
    <PackageReference Include="Azure.Identity" Version="1.*" />
    <PackageReference Include="Azure.Messaging.ServiceBus" Version="7.*" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.*" />
  </ItemGroup>
</Project>
