    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Anchorline.CostOpt</RootNamespace>
    <AssemblyName>anchorline-cost-opt</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
