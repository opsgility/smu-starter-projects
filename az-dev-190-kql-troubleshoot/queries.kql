// Anchorline KQL cheat sheet — 10 troubleshooting questions.

// 1. Top 5 slowest endpoints in the last hour (by p95).
requests
| where timestamp > ago(1h)
| summarize p95=percentile(duration, 95), rps=count()/3600.0 by name
| top 5 by p95 desc

// 2. Error rate per operation over the last 24h.
requests
| where timestamp > ago(24h)
| summarize total=count(), errors=countif(success == false) by name
| extend errorPct = round(100.0 * errors / total, 2)
| order by errorPct desc

// 3. Correlated errors between /checkout and any dependency.
requests
| where timestamp > ago(1h) and name == "GET /checkout" and success == false
| project operation_Id, timestamp
| join kind=inner (dependencies | where success == false) on operation_Id
| project timestamp, operation_Id, dependencyName=name1, resultCode

// 4. Dependency failure rate broken down by target.
dependencies
| where timestamp > ago(1h)
| summarize total=count(), fails=countif(success == false) by target
| extend failPct = round(100.0 * fails / total, 2)
| order by failPct desc

// 5. p50 / p95 / p99 latency per operation.
requests
| where timestamp > ago(1h)
| summarize p50=percentile(duration,50), p95=percentile(duration,95), p99=percentile(duration,99) by name

// 6. Traffic time-series per endpoint, 1-minute bins.
requests
| where timestamp > ago(1h)
| summarize rps=count() by name, bin(timestamp, 1m)
| render timechart

// 7. Requests that touched an exception.
requests
| where timestamp > ago(1h)
| join kind=inner (exceptions | project operation_Id, exType=type, outerMessage) on operation_Id

// 8. Slow requests that exceeded SLO (500ms) — with the offending dependency call.
requests | where timestamp > ago(1h) and duration > 500
| project operation_Id, request=name, duration
| join kind=inner (dependencies | project operation_Id, dep=name, depDuration=duration, target) on operation_Id
| top 20 by duration desc

// 9. Custom metric — orders.received.total by channel.
customMetrics
| where name == "orders.received.total" and timestamp > ago(1h)
| summarize sum=sum(valueSum) by tostring(customDimensions.channel), bin(timestamp, 5m)
| render timechart

// 10. Trace log correlation for a single failed request.
requests
| where operation_Id == "<paste-id>"
| project timestamp, name, duration, success
| union (traces | where operation_Id == "<paste-id>")
| order by timestamp asc
