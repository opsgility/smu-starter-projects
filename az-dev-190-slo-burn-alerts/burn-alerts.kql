// FAST burn — 2% budget in 1h. Trigger this as a log alert on the workspace.
// SLO: 99.5% of /orders complete in <= 500ms  =>  0.5% budget over 30 days.
// Fast-burn threshold = 2% of budget in 1 hour = burn rate ~14.4x.
let sloDurationMs = 500;
let target = 0.995;
requests
| where name == "GET /orders" and timestamp > ago(1h)
| summarize total=count(), good=countif(duration <= sloDurationMs)
| extend achieved = todouble(good) / total
| extend errorBudgetBurn = (1 - achieved) / (1 - target)
| where errorBudgetBurn > 14.4

// SLOW burn — 5% budget in 6h  =>  burn rate ~6x.
let sloDurationMs = 500;
let target = 0.995;
requests
| where name == "GET /orders" and timestamp > ago(6h)
| summarize total=count(), good=countif(duration <= sloDurationMs)
| extend achieved = todouble(good) / total
| extend errorBudgetBurn = (1 - achieved) / (1 - target)
| where errorBudgetBurn > 6.0
