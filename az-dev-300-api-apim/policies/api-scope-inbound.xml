<policies>
  <inbound>
    <base />
    <validate-jwt header-name="Authorization"
                  failed-validation-httpcode="401"
                  require-scheme="Bearer"
                  require-signed-tokens="true">
      <openid-config url="https://<external-tenant>.ciamlogin.com/<external-tid>/v2.0/.well-known/openid-configuration" />
      <audiences>
        <audience>api://taskforge-tenant</audience>
      </audiences>
      <required-claims>
        <claim name="tid" match="all">
          <value><external-tid></value>
        </claim>
      </required-claims>
    </validate-jwt>
    <set-header name="X-Correlation-Id" exists-action="skip">
      <value>@(Guid.NewGuid().ToString())</value>
    </set-header>
  </inbound>
</policies>
