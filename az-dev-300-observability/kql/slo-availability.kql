// TaskForge availability SLO: 99.5%
// Fast burn (14.4x for 5 min) — pages on-call
let sloTarget = 0.995;
let errorBudget = 1.0 - sloTarget;
let fastBurnThreshold = errorBudget * 14.4;   // 7.2%

requests
| where timestamp > ago(5m)
| where cloud_RoleName in ("taskforge-web", "taskforge-api")
| summarize total = count(), failed = countif(success == false and toint(resultCode) >= 500)
| extend errorRate = todouble(failed) / total
| where errorRate > fastBurnThreshold
