# In the SkillMeUp lab environment, ANTHROPIC_API_KEY is injected as a
# real value at container start by the Claude API proxy — you do NOT
# need your own Anthropic account for this lab.
ANTHROPIC_API_KEY=<injected-by-proxy-at-lab-start>

# The benchmark iterates a fixed list of models — see MODELS in
# src/benchmark.py. This env var is optional and only used if a specific
# exercise step tells you to override the default judge model.
ANTHROPIC_JUDGE_MODEL=claude-sonnet-5
