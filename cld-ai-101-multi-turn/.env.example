# In the SkillMeUp lab environment, ANTHROPIC_API_KEY is injected as a
# real value at container start by the Claude API proxy — you do NOT
# need your own Anthropic account for this lab.
#
# When running this starter locally against your own Anthropic account,
# create a key at https://platform.claude.com/settings/keys and paste
# it below.
ANTHROPIC_API_KEY=<injected-by-proxy-at-lab-start>

# Default model for the REPL. Sonnet 5 is the workhorse default.
ANTHROPIC_MODEL=claude-sonnet-5
