# Local Redis — the SaaS stack container runs redis-server on this URL automatically.
REDIS_URL=redis://127.0.0.1:6379

# Local Postgres — the SaaS stack container runs postgres on this URL automatically.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/lumentrail

# API port — pick anything free, 3000 is the default.
PORT=3000
