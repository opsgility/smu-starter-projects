DATABASE_URL=postgres://postgres:postgres@localhost:5432/lumentrail_auth
SESSION_SECRET=dev-only-not-for-production-replace-me

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3000/oauth/github/callback

# Local SMTP catcher — MailHog is preinstalled in the ClaudeSaasStack container.
# View all captured messages at http://localhost:8025 in the preview browser.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@lumentrail.example.com
APP_URL=http://localhost:3000
