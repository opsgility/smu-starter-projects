# Which track this lesson is actually wired to run against.
# gcs = Google Cloud Storage (primary — the lab runs this one).
# azure = Azure Blob (parallel-module reading; you can run it against your own Azure account).
STORAGE_TRACK=gcs

# GCS (primary track) — the lab platform populates GCS_PROJECT_ID when the
# project is assigned; GCS_BUCKET is a bucket you create in Lesson 1.
GCS_PROJECT_ID=
GCS_BUCKET=

# Azure Blob (parallel-module alternative) — only needed if you run the Azure track locally.
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_CONTAINER=photos

# Postgres — the SaaS stack provides a local postgres by default.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/lumentrail

# API port.
PORT=3000
