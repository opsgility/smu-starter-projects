# From the Stripe dashboard — test mode. Use publishable key for the frontend,
# secret key on the server. The webhook secret comes from `stripe listen` in Lesson 3.
STRIPE_SECRET_KEY=sk_test_<your-key>
STRIPE_PUBLISHABLE_KEY=pk_test_<your-key>
STRIPE_WEBHOOK_SECRET=whsec_<fill-in-lesson-3>

APP_BASE_URL=http://localhost:3000
PORT=3000
