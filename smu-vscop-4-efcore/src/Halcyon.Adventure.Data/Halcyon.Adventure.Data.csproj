<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Halcyon.Adventure.Data</RootNamespace>
    <AssemblyName>Halcyon.Adventure.Data</AssemblyName>
  </PropertyGroup>

  <!--
    EF Core 10 packages are deliberately absent from the starter.
    Lesson 2 Exercise 2 adds Microsoft.EntityFrameworkCore + .SqlServer + .Design here.
    Keeping them out of the starter forces students to run `dotnet add package` so they
    learn the names, versions, and the PrivateAssets block on the Design package.
  -->

</Project>
